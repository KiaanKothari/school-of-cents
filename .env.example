# Copy this file to .env and fill in your Supabase project's values.
# Find them in your Supabase dashboard under Project Settings -> API.
# See SETUP.md for the full walkthrough.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — only needed once your Google AdSense account is approved for
# this domain. Leave unset and the app runs exactly as before, with no ad
# space anywhere. See SETUP.md for the full walkthrough.
VITE_ADSENSE_CLIENT_ID=

# Optional — a GA4 "Measurement ID" (looks like G-XXXXXXXXXX) from
# https://analytics.google.com. Leave unset and no analytics script loads at
# all — no network calls, no cookies. See SETUP.md for what's tracked.
VITE_GA_MEASUREMENT_ID=
